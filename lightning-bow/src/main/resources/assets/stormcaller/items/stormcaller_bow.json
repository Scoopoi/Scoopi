{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_false": {
            "type": "minecraft:model",
            "model": "stormcaller:item/stormcaller_bow"
          },
          "on_true": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:use_duration",
            "scale": 0.05,
            "entries": [
              {
                "threshold": 0.65,
                "model": {
                  "type": "minecraft:model",
                  "model": "stormcaller:item/stormcaller_bow_pulling_1"
                }
              },
              {
                "threshold": 0.9,
                "model": {
                  "type": "minecraft:model",
                  "model": "stormcaller:item/stormcaller_bow_pulling_2"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "stormcaller:item/stormcaller_bow_pulling_0"
            }
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:model",
        "model": "stormcaller:item/stormcaller_bow_3d"
      },
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "scale": 0.05,
        "entries": [
          {
            "threshold": 0.65,
            "model": {
              "type": "minecraft:model",
              "model": "stormcaller:item/stormcaller_bow_3d_pulling_1"
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "minecraft:model",
              "model": "stormcaller:item/stormcaller_bow_3d_pulling_2"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "stormcaller:item/stormcaller_bow_3d_pulling_0"
        }
      }
    }
  }
}